function normalizarCarta(c){
  return {
    id: String(c.id),
    nome: c.nome || String(c.id),
    custoEnergia: Number(c.custoEnergia) || 1,
    poder: Number.isFinite(Number(c.poder)) ? Number(c.poder) : 0,
    descricao: c.descricao || '',
    tags: Array.isArray(c.tags) ? c.tags : [],
    habilidade: Array.isArray(c.habilidade) ? c.habilidade : [],
  };
}

function normalizarCampo(c){
  return {
    id: String(c.id),
    nome: c.nome || String(c.id),
    descricao: c.descricao || '',
    tags: Array.isArray(c.tags) ? c.tags : [],
    habilidade: Array.isArray(c.habilidade) ? c.habilidade : [],
  };
}

function validarConfiguracao(config){
  const erros = [];
  if (!config || typeof config !== 'object' || Array.isArray(config)){
    return { ok: false, erros: ['O arquivo precisa ser um objeto JSON com as chaves "cartas" e "campos".'] };
  }
  if (!Array.isArray(config.cartas) || config.cartas.length < 4){
    erros.push('É preciso uma lista "cartas" com pelo menos 4 cartas.');
  } else {
    config.cartas.forEach((c,i)=>{
      if (!c || !c.id) erros.push(`Carta #${i+1}: falta o campo "id".`);
      if (!c || !c.nome) erros.push(`Carta #${i+1} (${c && c.id || '?'}): falta o campo "nome".`);
      if (!c || typeof c.custoEnergia !== 'number') erros.push(`Carta "${c && c.id || i+1}": "custoEnergia" precisa ser um número.`);
      if (!c || typeof c.poder !== 'number') erros.push(`Carta "${c && c.id || i+1}": "poder" precisa ser um número.`);
    });
    const ids = config.cartas.map(c=>c && c.id);
    const duplicadas = [...new Set(ids.filter((id,i)=>ids.indexOf(id)!==i))];
    if (duplicadas.length) erros.push(`IDs de carta repetidos: ${duplicadas.join(', ')}.`);
  }
  if (!Array.isArray(config.campos) || config.campos.length < 3){
    erros.push('É preciso uma lista "campos" com pelo menos 3 campos de batalha.');
  } else {
    config.campos.forEach((c,i)=>{
      if (!c || !c.id) erros.push(`Campo #${i+1}: falta o campo "id".`);
      if (!c || !c.nome) erros.push(`Campo #${i+1} (${c && c.id || '?'}): falta o campo "nome".`);
    });
    const ids = config.campos.map(c=>c && c.id);
    const duplicadas = [...new Set(ids.filter((id,i)=>ids.indexOf(id)!==i))];
    if (duplicadas.length) erros.push(`IDs de campo repetidos: ${duplicadas.join(', ')}.`);
  }
  return { ok: erros.length === 0, erros };
}

