const MAX_RODADAS = 6;
const MAX_CARTAS_POR_LANE = 4;
const TAMANHO_MAO = 15; // Nova regra solicitada: 15 cartas na mão

function temTag(carta, tags){ return tags.some(t => carta.tags.includes(t)); }

const handlers = {
  bonusSeTagCampo(carta, ef, ctx){ const c = ctx.campo(carta); if (temTag({tags:c.tags}, ef.tagsCampo)) carta.poderAtual += ef.valor; },
  bonusSeCampoId(carta, ef, ctx){ const c = ctx.campo(carta); if (ef.campoIds.includes(c.id)) carta.poderAtual += ef.valor; },
  reduzSeNaoCampoTag(carta, ef, ctx){ const c = ctx.campo(carta); if (!temTag({tags:c.tags}, ef.tagsCampo)) carta.poderAtual += ef.valor; },
  bonusSeCampoCompartilhaTag(carta, ef, ctx){ const c = ctx.campo(carta); if (c.tags.some(t=>carta.tags.includes(t))) carta.poderAtual += ef.valor; },
  bonusSeCampoTagMultiplicador(carta, ef, ctx){ const c = ctx.campo(carta); if (temTag({tags:c.tags}, ef.tagsCampo)) carta.poderAtual *= ef.multiplicador; },
  reduzTagMesmoCampo(carta, ef, ctx){
    const alvos = ef.lado==='aliado' ? ctx.mesmoCampoLado(carta) : ef.lado==='inimigo' ? ctx.mesmoCampoInimigo(carta) : ctx.mesmoCampo(carta);
    alvos.forEach(a=>{ if (a!==carta && temTag(a, ef.tags)) a.poderAtual += ef.valor; });
  },
  bonusAliadoTagMesmoCampo(carta, ef, ctx){
    if (ef.condicaoCampoId && ctx.campo(carta).id !== ef.condicaoCampoId) return;
    if (ef.condicaoCampoTag && !ctx.campo(carta).tags.includes(ef.condicaoCampoTag)) return;
    ctx.mesmoCampoLado(carta).forEach(a=>{ if (a!==carta && temTag(a, ef.tags)) a.poderAtual += ef.valor; });
  },
  bonusSeInimigoTagMesmoCampo(carta, ef, ctx){ const inimigos = ctx.mesmoCampoInimigo(carta); if (inimigos.some(i=>temTag(i, ef.tags))) carta.poderAtual += ef.valor; },
  bonusPorContagemTag(carta, ef, ctx){
    const grupo = ef.escopo==='todosCampos' ? ctx.mesmoLado(carta) : ctx.mesmoCampo(carta);
    let n=0; grupo.forEach(c=>{ if (ef.excluirSeMesma && c===carta) return; if (temTag(c, ef.tags)) n++; });
    if (ef.maxAplicacoes && n >= (ef.minimoParaAtivar||1)) carta.poderAtual += ef.valorPorUnidade;
    else if (!ef.maxAplicacoes) carta.poderAtual += n*ef.valorPorUnidade;
  },
  reduzPoderCondicionalPorTagAlvo(carta, ef, ctx){
    ef.regras.forEach(r=>{
      if (r.aplicaEmSiMesma){ if (ctx.mesmoCampoInimigo(carta).some(i=>temTag(i,[r.tagAlvo]))) carta.poderAtual += r.valor; }
      else { ctx.mesmoCampoInimigo(carta).forEach(a=>{ if (temTag(a,[r.tagAlvo])) a.poderAtual += r.valor; }); }
    });
  },
  bonusAliadoTagMesmoLado(carta, ef, ctx){ ctx.mesmoLado(carta).forEach(a=>{ if (a!==carta && temTag(a, ef.tags)) a.poderAtual += ef.valor; }); },
  bonusSeCampoTagOuAliadoTag(carta, ef, ctx){
    const c = ctx.campo(carta);
    const campoOk = ef.tagsCampo && temTag({tags:c.tags}, ef.tagsCampo);
    const aliadoOk = ef.tagsAliado && ctx.mesmoCampoLado(carta).some(a=>a!==carta && temTag(a, ef.tagsAliado));
    if (campoOk || aliadoOk) carta.poderAtual += ef.valor;
  },
  bonusIniciativaCondicional(carta, ef, ctx){
    if (ef.tagsCampo){ const c = ctx.campo(carta); if (temTag({tags:c.tags}, ef.tagsCampo)) carta.poderAtual += ef.valor; return; }
    if (ef.tags){ ctx.mesmoCampoLado(carta).forEach(a=>{ if (temTag(a, ef.tags)) a.poderAtual += ef.valor; }); }
  },
  bonusTodasAliadasMesmoLado(carta, ef, ctx){ ctx.mesmoLado(carta).forEach(a=>{ if (a!==carta) a.poderAtual += ef.valor; }); },
  bonusPoderProprio(carta, ef){ carta.poderAtual += ef.valor; carta.poderBase += ef.valor; },
  bonusOutrosCamposLado(carta, ef, ctx){ ctx.outrasLanes(carta).forEach(i=>{ ctx.match.campos[i].bonusFixo[carta.dono] += ef.valor; }); },
  removerCartaFracaInimiga(carta, ef, ctx){
    const inimigos = ctx.mesmoCampoInimigo(carta); if (!inimigos.length) return;
    const fraca = inimigos.reduce((a,b)=> a.poderAtual<=b.poderAtual?a:b);
    fraca.poderBase += ef.valor; fraca.poderAtual += ef.valor;
    ctx.log(`${carta.nome} fez ${fraca.nome} recuar.`);
  },
  reduzirPelaMetadeCondicional(carta, ef, ctx){
    const c = ctx.campo(carta); if (!temTag({tags:c.tags}, ef.tagsCampo)) return;
    const alvo = ctx.mesmoCampoInimigo(carta).find(x=>temTag(x,[ef.tagAlvo]));
    if (alvo){ alvo.poderBase = Math.floor(alvo.poderBase/2); alvo.poderAtual = Math.floor(alvo.poderAtual/2); ctx.log(`${carta.nome} reduziu o poder de ${alvo.nome} pela metade.`); }
  },
  embaralharPosicaoInimiga(carta, ef, ctx){
    const oponente = carta.dono===0?1:0;
    const lanes = ctx.match.campos.map((_,i)=>i).filter(i=>ctx.match.campos[i].cartas.some(c=>c.dono===oponente));
    if (lanes.length<2) return;
    const origem = lanes[Math.floor(Math.random()*lanes.length)];
    const laneOrigem = ctx.match.campos[origem];
    const cand = laneOrigem.cartas.filter(c=>c.dono===oponente);
    const alvo = cand[Math.floor(Math.random()*cand.length)];
    const destinos = ctx.match.campos.map((_,i)=>i).filter(i=>i!==origem && ctx.match.campos[i].cartas.filter(c=>c.dono===oponente).length<MAX_CARTAS_POR_LANE);
    if (!destinos.length) return;
    const destino = destinos[Math.floor(Math.random()*destinos.length)];
    laneOrigem.cartas = laneOrigem.cartas.filter(c=>c!==alvo);
    alvo.campoIndex = destino; ctx.match.campos[destino].cartas.push(alvo);
    ctx.log(`${carta.nome} embaralhou ${alvo.nome} para outro campo.`);
  },
  removerCartaComTag(carta, ef, ctx){
    const alvo = ctx.mesmoCampoInimigo(carta).find(c=>temTag(c,[ef.tag]) && c.poderAtual<ef.poderMenorQue);
    if (alvo){ const lane = ctx.campoObj(carta); lane.cartas = lane.cartas.filter(c=>c!==alvo); ctx.log(`${carta.nome} removeu ${alvo.nome} do campo.`); }
  },
  zerarPoderTemporario(carta, ef, ctx){
    const alvo = ctx.mesmoCampoInimigo(carta).find(c=>temTag(c,[ef.tagAlvo]));
    if (alvo){ alvo.efeitosTemporarios.push({tipo:'poderZero', rodadasRestantes: ef.duracaoRodadas}); ctx.log(`${carta.nome} zerou o poder de ${alvo.nome}.`); }
  },
  roubarPoderTemporario(carta, ef, ctx){
    const alvo = ctx.mesmoCampoInimigo(carta).find(c=>temTag(c,[ef.tagAlvo]));
    if (alvo){ alvo.efeitosTemporarios.push({tipo:'roubada', dono: carta.dono, rodadasRestantes: ef.duracaoRodadas}); ctx.log(`${carta.nome} atraiu ${alvo.nome} para o seu lado.`); }
  },
  bloquearHabilidadeInimiga(carta, ef, ctx){
    const inimigos = ctx.mesmoCampoInimigo(carta); if (!inimigos.length) return;
    const alvo = inimigos[Math.floor(Math.random()*inimigos.length)];
    alvo.efeitosTemporarios.push({tipo:'habilidadeBloqueada', rodadasRestantes: ef.duracaoRodadas});
    ctx.log(`${carta.nome} adormeceu ${alvo.nome}.`);
  },
  danoDiretoPoderBase(carta, ef, ctx){
    const inimigos = ctx.mesmoCampoInimigo(carta); if (!inimigos.length) return;
    const alvo = inimigos[0]; alvo.poderBase += ef.valor; alvo.poderAtual += ef.valor;
    ctx.log(`${carta.nome} causou dano direto em ${alvo.nome}.`);
  },
  removerEfeitosNegativosAliado(carta, ef, ctx){ ctx.mesmoCampoLado(carta).forEach(a=>{ if (a!==carta) a.efeitosTemporarios = []; }); },
  ganhoCartaExtraBaixoCusto(carta, ef, ctx){ ctx.match.jogadores[carta.dono].energiaExtraProxCarta = true; ctx.log(`${carta.nome} concedeu jogada extra.`); },
  ganhoEnergiaExtraPorRodada(carta, ef, ctx){ ctx.match.jogadores[carta.dono]._bonusEnergiaRodada = (ctx.match.jogadores[carta.dono]._bonusEnergiaRodada||0) + ef.valor; },
  imunidadeContraTag(carta, ef){ carta._imune = carta._imune||[]; ef.tags.forEach(t=>{ if (!carta._imune.includes(t)) carta._imune.push(t); }); },
  zerarPoderTag(carta, ef, ctx){
    ctx.mesmoCampo(carta).forEach(a=>{ if (a.dono!==carta.dono && temTag(a, ef.tags) && !(a._imune||[]).some(t=>ef.tags.includes(t))) a.poderAtual = 0; });
  },
  danoContinuoPorTurno(carta, ef, ctx){
    ctx.mesmoCampo(carta).forEach(a=>{ if (temTag(a, ef.tags) && !(a._imune||[]).includes('impacto')) a.poderBase += ef.valor; });
  },
  trocarMaoComAdversario(carta, ef, ctx) {
    const meuId = carta.dono;
    const advId = meuId === 0 ? 1 : 0;
    const tempMao = [...ctx.match.jogadores[meuId].mao];
    ctx.match.jogadores[meuId].mao = [...ctx.match.jogadores[advId].mao];
    ctx.match.jogadores[advId].mao = tempMao;
    ctx.match.jogadores[meuId].mao.forEach(c => c.dono = meuId);
    ctx.match.jogadores[advId].mao.forEach(c => c.dono = advId);
    ctx.log(`⚠️ ${carta.nome} TROCOU as mãos dos jogadores!`);
  }
};

const campoHandlers = {
  imunidadeCampoContraTag(campoDef, ef, lane){ lane.cartas.forEach(c=>{ c._imune=c._imune||[]; ef.tags.forEach(t=>{ if(!c._imune.includes(t)) c._imune.push(t); }); }); },
  bonusTodasCartasCampo(campoDef, ef, lane){ lane.cartas.forEach(c=>{ c.poderAtual += ef.valor; }); },
  bonusTagCampo(campoDef, ef, lane){ if (lane.anulado) return; lane.cartas.forEach(c=>{ if (temTag(c, ef.tags)) c.poderAtual += ef.valor; }); },
  reduzTagCampoSeOutraTag(campoDef, ef, lane){ lane.cartas.forEach(c=>{ if (temTag(c,[ef.tagAlvo]) && temTag(c,[ef.tagCondicao])) c.poderAtual += ef.valor; }); },
  regenTagCampo(campoDef, ef, lane){ lane.cartas.forEach(c=>{ if (temTag(c, ef.tags)) c.poderBase += ef.valor; }); },
  dobrarCustoTagCampo(){},
  reduzSemTagCampo(campoDef, ef, lane){ lane.cartas.forEach(c=>{ if (temTag(c,[ef.tagCondicaoOposta]) && !temTag(c,[ef.tagExigida])) c.poderAtual += ef.valor; }); },
  danoContinuoCampo(campoDef, ef, lane){ lane.cartas.forEach(c=>{ if (temTag(c, ef.tags)) c.poderBase += ef.valor; }); },
  bonusIniciativaTagCampo(campoDef, ef, lane){ lane.cartas.forEach(c=>{ if (temTag(c, ef.tags)) c.poderAtual += ef.valor; }); },
  resistenciaPrimeiroDanoTag(campoDef, ef, lane){ campoHandlers.imunidadeCampoContraTag(campoDef, ef, lane); },
  anularBonusCampoSeCartaId(campoDef, ef, lane){ if (lane.cartas.some(c=>c.id===ef.cartaId)) lane.anulado = true; },
  reduzTodasCampoSeTagPresente(campoDef, ef, lane){
    if (!lane.cartas.some(c=>temTag(c, ef.tagGatilho))) return;
    lane.cartas.forEach(c=>{ if (temTag(c,[ef.tagAlvo])) c.poderAtual += ef.valor; });
  },
  bonusSeTagCampoIgual(campoDef, ef, lane){ if (temTag({tags:campoDef.tags}, ef.tagsCampo)) lane.cartas.forEach(c=>{ c.poderAtual += ef.valor; }); },
  duplicarBonusPropriaTag(campoDef, ef, lane){
    lane.cartas.forEach(c=>{ if (temTag(c, ef.tags) && c.poderAtual > c.poderBase) c.poderAtual += (c.poderAtual - c.poderBase); });
  },
};

function embaralhar(arr){ const a=[...arr]; for(let i=a.length-1;i>0;i--){ const j=Math.floor(Math.random()*(i+1)); [a[i],a[j]]=[a[j],a[i]]; } return a; }

function sortearMao(pool){
  if (!pool || pool.length === 0) return [];
  const c1 = pool.filter(c=>c.custoEnergia===1);
  const c2 = pool.filter(c=>c.custoEnergia===2);
  const ancoras = [];
  if (c1.length) ancoras.push(c1[Math.floor(Math.random()*c1.length)]);
  if (c2.length){
    const candidatosC2 = c2.filter(c=>!ancoras.some(a=>a.id===c.id));
    if (candidatosC2.length) ancoras.push(candidatosC2[Math.floor(Math.random()*candidatosC2.length)]);
  }
  const resto = pool.filter(c=>!ancoras.some(a=>a.id===c.id));
  const restantes = Math.max(0, TAMANHO_MAO - ancoras.length);
  return embaralhar([...ancoras, ...embaralhar(resto).slice(0, restantes)]);
}

function novaInstancia(def, dono){ return JSON.parse(JSON.stringify({...def, poderBase:def.poder, poderAtual:def.poder, dono, campoIndex:null, efeitosTemporarios:[], _imune:[]})); }

function iniciarPartida(){
  const camposDaPartida = embaralhar(CAMPOS_TEMA).slice(0,3);
  const jogadores = ['Você','Adversário'].map(nome=>({ nome, mao: sortearMao(CARTAS_TEMA), energiaDisponivel:0, energiaExtraProxCarta:false, _bonusEnergiaRodada:0 }));
  jogadores.forEach((j,idx)=> j.mao = cartaInstanciada(j.mao.map(c=>novaInstancia(c, idx))));
  return { campos: camposDaPartida.map(def=>({def, cartas:[], bonusFixo:{0:0,1:0}, anulado:false})), jogadores, rodada:0, log:[] };
}

function criarContexto(match){
  return {
    match, log:(m)=>match.log.push(m), campo:(c)=>match.campos[c.campoIndex].def, campoObj:(c)=>match.campos[c.campoIndex],
    mesmoCampo:(c)=>match.campos[c.campoIndex].cartas, mesmoCampoLado:(c)=>match.campos[c.campoIndex].cartas.filter(x=>x.dono===c.dono),
    mesmoCampoInimigo:(c)=>match.campos[c.campoIndex].cartas.filter(x=>x.dono!==c.dono),
    mesmoLado:(c)=>match.campos.flatMap(l=>l.cartas).filter(x=>x.dono===c.dono),
    outrasLanes:(c)=>match.campos.map((_,i)=>i).filter(i=>i!==c.campoIndex),
  };
}

function custoParaJogar(def, laneIndex, match){
  const lane = match.campos[laneIndex]; let custo = def.custoEnergia;
  (lane.def.habilidade||[]).forEach(ef=>{ if (ef.efeito==='dobrarCustoTagCampo' && ef.tags.some(t=>def.tags.includes(t))) custo *= 2; });
  return custo;
}

// -------------------------------------------------------------
// INTELIGÊNCIA ARTIFICIAL DO BOT
// Simula cada jogada candidata com o próprio motor de regras (clona o
// estado, resolve habilidades "aoRevelar" e recalcula os poderes) e
// escolhe sempre a jogada de maior ganho real — considerando sinergias
// de campo, buffs/debuffs e habilidades de remoção.
// -------------------------------------------------------------

function clonarMatch(match){
  return JSON.parse(JSON.stringify(match));
}

function avaliarEstado(match, donoIdx){
  const advIdx = donoIdx === 0 ? 1 : 0;
  let score = 0;
  match.campos.forEach(lane=>{
    const pts = pontuarLane(lane);
    score += (pts[donoIdx]||0) - (pts[advIdx]||0);
  });
  const r = apurarResultado(match);
  score += ((r.vit[donoIdx]||0) - (r.vit[advIdx]||0)) * 25;
  return score;
}

function simularJogada(matchBase, carta, laneIndex, donoIdx){
  const clone = clonarMatch(matchBase);
  const cartaClone = JSON.parse(JSON.stringify(carta));
  cartaClone.campoIndex = laneIndex;
  cartaClone.dono = donoIdx;
  clone.campos[laneIndex].cartas.push(cartaClone);
  resolverAoRevelar(clone, [cartaClone]);
  recalcularPoderes(clone);
  return clone;
}

function escolherJogadasBot(jogador, match, donoIdx){
  const escolhidas = [];
  let energia = jogador.energiaDisponivel;
  const idsEscolhidos = new Set();
  const cartasDisponiveis = jogador.mao.filter(c => c.campoIndex === null);

  let estadoTrabalho = clonarMatch(match);
  const ocupacao = estadoTrabalho.campos.map(l => l.cartas.filter(c => c.dono === donoIdx).length);

  let iteracoes = 0;
  while (energia > 0 && iteracoes < 40) {
    iteracoes++;
    const scoreAtual = avaliarEstado(estadoTrabalho, donoIdx);
    let melhor = null;

    for (const carta of cartasDisponiveis) {
      if (idsEscolhidos.has(carta._instanceId)) continue;
      for (let lane = 0; lane < estadoTrabalho.campos.length; lane++) {
        if (ocupacao[lane] >= MAX_CARTAS_POR_LANE) continue;
        const custo = custoParaJogar(carta, lane, estadoTrabalho);
        if (custo > energia) continue;

        const simulado = simularJogada(estadoTrabalho, carta, lane, donoIdx);
        const delta = avaliarEstado(simulado, donoIdx) - scoreAtual;
        const pontuacao = delta + (delta / Math.max(custo, 1)) * 0.75;

        if (!melhor || pontuacao > melhor.pontuacao) {
          melhor = { carta, lane, custo, delta, pontuacao, simulado };
        }
      }
    }

    if (!melhor) break;
    if (melhor.delta <= 0 && energia <= 2) break;

    escolhidas.push({ carta: melhor.carta, lane: melhor.lane, custo: melhor.custo });
    idsEscolhidos.add(melhor.carta._instanceId);
    ocupacao[melhor.lane]++;
    energia -= melhor.custo;
    estadoTrabalho = melhor.simulado;
  }

  const temBonusGratis = jogador.energiaExtraProxCarta || estadoTrabalho.jogadores[donoIdx].energiaExtraProxCarta;
  if (temBonusGratis) {
    const restantes = cartasDisponiveis.filter(c => !idsEscolhidos.has(c._instanceId));
    let melhorGratis = null;
    for (const carta of restantes) {
      for (let lane = 0; lane < estadoTrabalho.campos.length; lane++) {
        if (ocupacao[lane] >= MAX_CARTAS_POR_LANE) continue;
        const simulado = simularJogada(estadoTrabalho, carta, lane, donoIdx);
        const delta = avaliarEstado(simulado, donoIdx) - avaliarEstado(estadoTrabalho, donoIdx);
        if (!melhorGratis || delta > melhorGratis.delta) melhorGratis = { carta, lane, delta };
      }
    }
    if (melhorGratis) {
      escolhidas.push({ carta: melhorGratis.carta, lane: melhorGratis.lane, custo: 0 });
      jogador.energiaExtraProxCarta = false;
    }
  }

  return escolhidas;
}

function jogarCartas(match, jogadorIdx, escolhidas){
  const jogador = match.jogadores[jogadorIdx];
  escolhidas.forEach(({carta, lane, custo})=>{
    carta.campoIndex = lane; match.campos[lane].cartas.push(carta); jogador.energiaDisponivel -= custo;
    jogador.mao = jogador.mao.filter(c => c._instanceId !== carta._instanceId);
    match.log.push(`${jogador.nome} jogou "${carta.nome}" em "${match.campos[lane].def.nome}".`);
  });
}

function resolverAoRevelar(match, novas){
  const ctx = criarContexto(match);
  [...novas].sort((a,b)=>b.custoEnergia-a.custoEnergia).forEach(carta=>{
    (carta.habilidade||[]).forEach(ef=>{ if (ef.gatilho!=='aoRevelar') return; const fn=handlers[ef.efeito]; if (fn) fn(carta, ef, ctx); });
  });
}

function recalcularPoderes(match){
  const ctx = criarContexto(match);
  match.campos.forEach(l=>{ l.anulado=false; l.cartas.forEach(c=>{ c.poderAtual=c.poderBase; }); });
  match.campos.forEach(l=>{ (l.def.habilidade||[]).forEach(ef=>{ if (ef.gatilho==='continuo' && ef.efeito==='anularBonusCampoSeCartaId'){ const fn=campoHandlers[ef.efeito]; if (fn) fn(l.def, ef, l); } }); });
  match.campos.forEach(l=>{ l.cartas.forEach(carta=>{ (carta.habilidade||[]).forEach(ef=>{ if (ef.gatilho!=='continuo') return; const fn=handlers[ef.efeito]; if (fn) fn(carta, ef, ctx); }); }); });
  match.campos.forEach(l=>{ (l.def.habilidade||[]).forEach(ef=>{ if (ef.gatilho!=='continuo' || ef.efeito==='anularBonusCampoSeCartaId') return; const fn=campoHandlers[ef.efeito]; if (fn) fn(l.def, ef, l, ctx); }); });
  match.campos.forEach(l=>{ l.cartas.forEach(c=>{ c.poderAtual += l.bonusFixo[c.dono]||0; c.efeitosTemporarios.forEach(te=>{ if (te.tipo==='poderZero') c.poderAtual = 0; }); }); });
}

function aplicarFinalDeRodada(match){
  const ctx = criarContexto(match);
  match.campos.forEach(l=>{
    l.cartas.forEach(carta=>{ (carta.habilidade||[]).forEach(ef=>{ if (ef.gatilho!=='finalDeRodada') return; const fn=handlers[ef.efeito]; if (fn) fn(carta, ef, ctx); }); });
    (l.def.habilidade||[]).forEach(ef=>{ if (ef.gatilho!=='finalDeRodada') return; const fn=campoHandlers[ef.efeito]; if (fn) fn(l.def, ef, l, ctx); });
  });
  match.campos.forEach(l=>{ l.cartas.forEach(c=>{ c.efeitosTemporarios = c.efeitosTemporarios.map(te=>({...te, rodadasRestantes: te.rodadasRestantes-1})).filter(te=>te.rodadasRestantes>=0); }); });
}

function pontuarLane(lane){
  const total = {0:0,1:0};
  lane.cartas.forEach(c=>{ const dono = (c.efeitosTemporarios.find(te=>te.tipo==='roubada')||{}).dono ?? c.dono; total[dono]+=c.poderAtual; });
  return total;
}

function apurarResultado(match){
  let vit = {0:0,1:0};
  const detalhes = match.campos.map(l=>{
    const total = pontuarLane(l); let vencedor=null;
    if (total[0]>total[1]){ vit[0]++; vencedor=0; } else if (total[1]>total[0]){ vit[1]++; vencedor=1; }
    return {campo:l.def.nome, pontuacao: total, vencedor};
  });
  let vencedorPartida = null;
  if (vit[0]>=2) vencedorPartida=0; else if (vit[1]>=2) vencedorPartida=1;
  return {detalhes, vit, vencedorPartida};
}

