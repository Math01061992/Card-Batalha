  'Quando terminar suas jogadas na rodada, toque em "Finalizar Turno" para revelar as jogadas do oponente e atualizar o poder de cada campo.',
  'Ao final da 6ª rodada o placar de cada campo é fechado, e quem tiver vencido mais campos — você ou o oponente — é declarado o vencedor da partida.'
];

document.getElementById('lista-como-jogar').innerHTML =
  FRASES_COMO_JOGAR.map(frase => `<li>${frase}</li>`).join('');

document.getElementById('btn-abrir-como-jogar').onclick = ()=>{
  document.getElementById('popup-como-jogar').classList.remove('oculto');
};
document.getElementById('btn-fechar-como-jogar').onclick = ()=>{
  document.getElementById('popup-como-jogar').classList.add('oculto');
};
</script>
</body>
</html>
