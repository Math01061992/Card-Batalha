   LÓGICA VISUAL DA UI 
   ============================================================ */

let matchState = null;
let cartaSelecionadaId = null;
let jogadasHumanoRodada = [];
let jogadaGratisDisponivel = false; // concedida pelo Guaraná (jogador 0), consumida na rodada seguinte
let snapshotInicialPartida = null; // estado logo após a distribuição das mãos, usado por "Reiniciar Partida"
let partidaEncerrada = false;

function ativarModoEmJogo(){
  const btn = document.getElementById('btn-confirmar');
  btn.textContent = 'Finalizar Turno';
  btn.onclick = confirmarRodada;
}

function ativarModoFimDeJogo(){
  const btn = document.getElementById('btn-confirmar');
  btn.textContent = 'Jogar de novo';
  btn.onclick = iniciarNovaPartida;
}

function iniciarNovaPartida(){
  matchState = iniciarPartida();
  snapshotInicialPartida = clonarMatch(matchState);
  jogadasHumanoRodada = [];
  cartaSelecionadaId = null;
  jogadaGratisDisponivel = false;
  partidaEncerrada = false;
  document.getElementById('overlay').classList.add('oculto');
  ativarModoEmJogo();
  proximaRodada();
}

function reiniciarPartidaAtual(){
  if (!snapshotInicialPartida) return;
  matchState = clonarMatch(snapshotInicialPartida);
  jogadasHumanoRodada = [];
  cartaSelecionadaId = null;
  jogadaGratisDisponivel = false;
  partidaEncerrada = false;
  document.getElementById('overlay').classList.add('oculto');
  ativarModoEmJogo();
  proximaRodada();
}

function voltarTelaInicial(){
  document.getElementById('overlay').classList.add('oculto');
  document.getElementById('area-jogo').classList.add('oculto');
  document.getElementById('tela-inicial').classList.remove('oculto');
  mostrarMensagemSetup('', '');
}

function energiaGastaPendente(){ return jogadasHumanoRodada.reduce((s,j)=>s+j.custo,0); }
function energiaRestante(){ return matchState.jogadores[0].energiaDisponivel - energiaGastaPendente(); }
function ocupacaoLaneComPendentes(laneIdx){
  const base = matchState.campos[laneIdx].cartas.filter(c=>c.dono===0).length;
  const pend = jogadasHumanoRodada.filter(j=>j.lane===laneIdx).length;
  return base + pend;
}

function proximaRodada(){
  matchState.rodada += 1;
  const r = matchState.rodada;
  matchState.log.push(`--- Rodada ${r} ---`);
  if (r<=3) matchState.log.push(`Campo revelado: "${matchState.campos[r-1].def.nome}"`);
  matchState.jogadores.forEach(j=>{ j.energiaDisponivel += r + (j._bonusEnergiaRodada||0); });
  jogadasHumanoRodada = [];
  cartaSelecionadaId = null;
  if (matchState.jogadores[0].energiaExtraProxCarta){
    jogadaGratisDisponivel = true;
    matchState.jogadores[0].energiaExtraProxCarta = false;
    matchState.log.push('🎁 O Guaraná concedeu uma jogada grátis nesta rodada!');
  }
  renderizarTudo();
}

function selecionarCarta(cartaId){
  if (partidaEncerrada) return;
  const carta = matchState.jogadores[0].mao.find(c=>c._instanceId===cartaId);
  if (!carta || carta.campoIndex!==null) return;
  const jaEstaEmJogadas = jogadasHumanoRodada.some(j=>j.carta===carta);
  if (jaEstaEmJogadas) return;
  cartaSelecionadaId = (cartaSelecionadaId===carta._instanceId) ? null : carta._instanceId;
  renderizarTudo();
}

function clicarLane(laneIdx){
  if (partidaEncerrada) return;
  if (!cartaSelecionadaId) return;
  const carta = matchState.jogadores[0].mao.find(c=>c._instanceId===cartaSelecionadaId);
  if (!carta) return;
  if (ocupacaoLaneComPendentes(laneIdx) >= MAX_CARTAS_POR_LANE) return;
  let custo = custoParaJogar(carta, laneIdx, matchState);
  let usouGratis = false;
  if (jogadaGratisDisponivel){ custo = 0; usouGratis = true; }
  else if (custo > energiaRestante()) return;
  jogadasHumanoRodada.push({carta, lane:laneIdx, custo, gratis:usouGratis});
  if (usouGratis) jogadaGratisDisponivel = false;
  cartaSelecionadaId = null;
  renderizarTudo();
}

function desfazerUltimaJogada(){
  const removida = jogadasHumanoRodada.pop();
  if (removida && removida.gratis) jogadaGratisDisponivel = true;
  renderizarTudo();
}

function confirmarRodada(){
  const bot = matchState.jogadores[1];
  const escolhidasBot = escolherJogadasBot(bot, matchState, 1);

  jogarCartas(matchState, 0, jogadasHumanoRodada);
  jogarCartas(matchState, 1, escolhidasBot);

  const todasNovas = [...jogadasHumanoRodada.map(j=>j.carta), ...escolhidasBot.map(j=>j.carta)];
  resolverAoRevelar(matchState, todasNovas);
  recalcularPoderes(matchState);
  aplicarFinalDeRodada(matchState);
  recalcularPoderes(matchState);

  if (matchState.rodada >= MAX_RODADAS){ mostrarResultadoFinal(); }
  else { proximaRodada(); }
}

function mostrarResultadoFinal(){
  jogadasHumanoRodada = [];
  partidaEncerrada = true;
  const r = apurarResultado(matchState);
  const overlay = document.getElementById('overlay');
  const titulo = document.getElementById('resultado-titulo');
  const detalhes = document.getElementById('resultado-detalhes');
  titulo.textContent = r.vencedorPartida===null ? 'Empate!' : (r.vencedorPartida===0 ? 'Você Venceu!' : 'O seu adversário venceu');
  detalhes.innerHTML = r.detalhes.map(d=>`
    <div class="linha-resultado">
      <span>${d.campo}</span>
      <span style="font-family:'Space Grotesk'; color: #60a5fa;">Você ${d.pontuacao[0]} &nbsp;–&nbsp; ${d.pontuacao[1]} Adversário</span>
    </div>
  `).join('') + `<div class="linha-resultado" style="border:none; font-weight:800; font-size: 1.2rem; margin-top:16px;">
      <span>Campos Vencidos</span><span style="color: #c084fc;">${r.vit[0]} – ${r.vit[1]}</span>
    </div>`;
  overlay.classList.remove('oculto');
  ativarModoFimDeJogo();
  renderizarTudo();
}

/* ---------- Renderização ---------- */

function renderizarTudo(){
  renderizarCampos();
  renderizarMao();
  renderizarStatus();
  document.getElementById('pill-rodada').textContent = `Rodada ${Math.max(matchState.rodada,1)} / ${MAX_RODADAS}`;
}

function cartaInstanciada(list){
  list.forEach((c,i)=>{ if (!c._instanceId) c._instanceId = c.id + '_' + i + '_' + Math.random().toString(36).slice(2,7); });
  return list;
}

function abrirPopupCarta(c){
  const overlay = document.getElementById('carta-popup');
