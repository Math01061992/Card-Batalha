function parseTags(valor){
  if (!valor) return [];
  return String(valor).split(',').map(s=>s.trim()).filter(Boolean);
}

// Traduz as palavras-chave simples da planilha para os efeitos reais do motor do jogo
function construirHabilidadeCarta(linha){
  const efeito = String(linha['efeito (opcional)'] || '').trim();
  if (!efeito || efeito === '(vazio)') return [];
  const tagsAlvo = parseTags(linha['tags_alvo (opcional)']);
  const tagsCampo = parseTags(linha['tags_campo (opcional)']);
  const valor = Number(linha['valor (opcional)']) || 0;
  switch (efeito) {
    case 'bonus_se_campo_tag':
      return [{ gatilho: 'continuo', efeito: 'bonusSeTagCampo', tagsCampo, valor }];
    case 'bonus_aliados_mesma_tag':
      return [{ gatilho: 'continuo', efeito: 'bonusAliadoTagMesmoCampo', tags: tagsAlvo, valor }];
    case 'reduz_aliados_mesma_tag':
      return [{ gatilho: 'continuo', efeito: 'reduzTagMesmoCampo', tags: tagsAlvo, lado: 'aliado', valor }];
    case 'reduz_inimigos_mesma_tag':
      return [{ gatilho: 'continuo', efeito: 'reduzTagMesmoCampo', tags: tagsAlvo, lado: 'inimigo', valor }];
    case 'bonus_todas_suas_cartas':
      return [{ gatilho: 'continuo', efeito: 'bonusTodasAliadasMesmoLado', valor }];
    default:
      return [];
  }
}

function construirHabilidadeCampo(linha){
  const efeito = String(linha['efeito (opcional)'] || '').trim();
  if (!efeito || efeito === '(vazio)') return [];
  const tagsAlvo = parseTags(linha['tags_alvo (opcional)']);
  const valor = Number(linha['valor (opcional)']) || 0;
  switch (efeito) {
    case 'bonus_tag_no_campo':
      return [{ gatilho: 'continuo', efeito: 'bonusTagCampo', tags: tagsAlvo, valor }];
    case 'bonus_todas_cartas_no_campo':
      return [{ gatilho: 'continuo', efeito: 'bonusTodasCartasCampo', valor }];
    default:
      return [];
  }
}

function planilhaParaLinhas(workbook, nomeAba){
  const sheet = workbook.Sheets[nomeAba];
  if (!sheet) return [];
  return XLSX.utils.sheet_to_json(sheet, { defval: '' });
}

function ehLinhaDeExemplo(id){
  return String(id || '').trim().indexOf('exemplo_') === 0;
}

function lerNomeJogoDaPlanilha(workbook){
  const linhas = planilhaParaLinhas(workbook, 'Config');
  const linha = linhas.find(l => String(l['Campo'] || '').trim().toLowerCase() === 'nome do jogo');
  return linha ? String(linha['Valor'] || '').trim() : '';
}

function lerCartasDaPlanilha(workbook){
  const linhas = planilhaParaLinhas(workbook, 'Cartas');
  return linhas
    .filter(l => String(l['id'] || '').trim() && !ehLinhaDeExemplo(l['id']))
    .map(l => ({
      id: String(l['id']).trim(),
      nome: String(l['nome'] || '').trim(),
      custoEnergia: Number(l['custo_energia']) || 1,
      poder: Number.isFinite(Number(l['poder'])) ? Number(l['poder']) : 0,
      descricao: String(l['descricao'] || '').trim(),
      tags: parseTags(l['tags']),
      habilidade: construirHabilidadeCarta(l),
    }));
}

function lerCamposDaPlanilha(workbook){
  const linhas = planilhaParaLinhas(workbook, 'Campos');
  return linhas
    .filter(l => String(l['id'] || '').trim() && !ehLinhaDeExemplo(l['id']))
    .map(l => ({
      id: String(l['id']).trim(),
      nome: String(l['nome'] || '').trim(),
      descricao: String(l['descricao'] || '').trim(),
      tags: parseTags(l['tags']),
      habilidade: construirHabilidadeCampo(l),
    }));
}

function carregarPlanilhaExcel(){
  const input = document.getElementById('input-planilha-config');
  if (!input.files || !input.files[0]){
    mostrarMensagemSetup('Selecione um arquivo .xlsx antes de continuar.', 'erro', 'setup-mensagem-planilha');
    return;
  }
  if (typeof XLSX === 'undefined'){
    mostrarMensagemSetup('Não foi possível carregar o leitor de planilhas. Verifique sua conexão com a internet e tente novamente.', 'erro', 'setup-mensagem-planilha');
    return;
  }
  const reader = new FileReader();
  reader.onload = (ev)=>{
    let workbook;
    try {
      const dados = new Uint8Array(ev.target.result);
      workbook = XLSX.read(dados, { type: 'array' });
    } catch (e) {
      mostrarMensagemSetup('Não foi possível ler a planilha. Verifique se é um arquivo .xlsx válido.', 'erro', 'setup-mensagem-planilha');
      return;
    }
    try {
      const nomeJogo = lerNomeJogoDaPlanilha(workbook);
      const cartas = lerCartasDaPlanilha(workbook);
      const campos = lerCamposDaPlanilha(workbook);
      const validacao = validarConfiguracao({ nomeJogo, cartas, campos });
      if (!validacao.ok){
        mostrarMensagemSetup('<b>Corrija a planilha antes de continuar:</b><br>' + validacao.erros.map(e=>'• '+e).join('<br>'), 'erro', 'setup-mensagem-planilha');
        return;
      }
      mostrarMensagemSetup(`Planilha carregada: ${cartas.length} cartas e ${campos.length} campos. Iniciando...`, 'sucesso', 'setup-mensagem-planilha');
      iniciarJogoComDados(cartas.map(normalizarCarta), campos.map(normalizarCampo), nomeJogo, true);
    } catch (e) {
      mostrarMensagemSetup('Ocorreu um erro ao interpretar a planilha: ' + e.message, 'erro', 'setup-mensagem-planilha');
    }
  };
  reader.onerror = ()=> mostrarMensagemSetup('Ocorreu um erro ao ler o arquivo.', 'erro', 'setup-mensagem-planilha');
  reader.readAsArrayBuffer(input.files[0]);
}

function base64ParaUint8Array(base64){
  const binario = atob(base64);
  const bytes = new Uint8Array(binario.length);
  for (let i = 0; i < binario.length; i++) bytes[i] = binario.charCodeAt(i);
  return bytes;
}

function baixarModeloExcel(){
  const bytes = base64ParaUint8Array(MODELO_XLSX_BASE64);
  const blob = new Blob([bytes], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = 'modelo-batalha-dos-biomas.xlsx';
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  URL.revokeObjectURL(url);
}

