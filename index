<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Batalha dos Cards - Premium Edition</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;700;800&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
  :root {
    --bg-dark: #09090b;
    --panel-bg: rgba(15, 23, 42, 0.65); /* Painéis Translúcidos */
    --panel-border: rgba(255, 255, 255, 0.15);
    --accent-glow: #3b82f6;
    --text-main: #f8fafc;
    --text-muted: #cbd5e1;
    --buff-color: #10b981;
    --nerf-color: #ef4444;
    --energy-color: #0ea5e9;
  }
  
  * { box-sizing: border-box; }
  
  body {
    margin: 0;
    color: var(--text-main);
    font-family: 'Outfit', sans-serif;
    height: 100vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    
    /* Fundo padrão: gradiente (nenhuma imagem externa necessária) */
    background: radial-gradient(circle at 20% 15%, rgba(59,130,246,0.18), transparent 45%),
                radial-gradient(circle at 85% 80%, rgba(124,58,237,0.18), transparent 50%),
                var(--bg-dark);
    background-attachment: fixed;
  }

  /* Fundo usado quando o jogador carrega um arquivo de cartas/campos personalizado */
  body.tema-custom {
    background-image: url('data:image/jpeg;base64,');
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    background-color: var(--bg-dark);
  }

  /* Máscara escura sobre a imagem para garantir a legibilidade do jogo */
  body::before {
    content: "";
    position: fixed;
    inset: 0;
    background: rgba(9, 9, 11, 0.60); /* Escurece a imagem em 60% */
    backdrop-filter: blur(2px); /* Desfoque leve na arte de fundo */
    z-index: -1;
  }

  h1, h2, h3, .number-font { font-family: 'Space Grotesk', sans-serif; }

  #game-arena {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    overflow-y: auto;
  }

  #area-jogo {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    width: 100%;
  }

  /* Tela inicial de configuração */
  #tela-inicial {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    overflow-y: auto;
  }
  .setup-painel {
    width: 100%; max-width: 480px;
    background: var(--panel-bg); border: 1px solid var(--panel-border); border-radius: 24px;
    padding: 36px; backdrop-filter: blur(12px);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.6), inset 0 0 20px rgba(255,255,255,0.05);
  }
  .setup-titulo {
    font-size: 2rem; font-weight: 800; margin: 0 0 12px;
    background: linear-gradient(to right, #4ade80, #3b82f6, #c084fc);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    text-shadow: 0 4px 15px rgba(0,0,0,0.5);
  }
  .setup-subtitulo { color: var(--text-muted); margin: 0 0 24px; font-size: 0.95rem; line-height: 1.6; }
  .setup-acoes-principais { display: flex; flex-direction: column; gap: 12px; }
  .setup-btn-principal { width: 100%; font-size: 0.95rem; padding: 16px 20px; text-align: center; }
  .setup-input-arquivo { font-size: 0.78rem; color: var(--text-muted); width: 100%; }
  .link-modelo {
    color: #60a5fa; font-size: 0.82rem; cursor: pointer; text-decoration: underline;
    background: none; border: none; font-family: 'Outfit', sans-serif;
  }
  .link-modelo:hover { color: #93c5fd; }
  .setup-mensagem {
    display: none; font-size: 0.85rem; padding: 12px 16px; border-radius: 10px; margin-top: 16px; line-height: 1.6;
  }
  .setup-mensagem.erro { display: block; background: rgba(239,68,68,0.15); border: 1px solid rgba(239,68,68,0.4); color: #fecaca; }
  .setup-mensagem.sucesso { display: block; background: rgba(16,185,129,0.15); border: 1px solid rgba(16,185,129,0.4); color: #a7f3d0; }
  .lista-temas-prontos { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .btn-tema-pronto {
    display: flex; align-items: center; gap: 10px; text-align: left;
    background: rgba(0,0,0,0.35); border: 1px solid var(--panel-border); border-radius: 12px;
    padding: 14px 16px; font-family: 'Outfit', sans-serif; font-size: 0.88rem; font-weight: 600;
    color: var(--text-main); cursor: pointer; transition: transform 0.12s ease, border-color 0.12s ease;
  }
  .btn-tema-pronto:hover { transform: translateY(-2px); border-color: rgba(255,255,255,0.4); }
  .setup-divisor { display: flex; align-items: center; gap: 12px; margin: 22px 0 16px; color: var(--text-muted); font-size: 0.78rem; }
  .setup-divisor::before, .setup-divisor::after { content: ""; flex: 1; height: 1px; background: var(--panel-border); }
  .setup-divisor span { padding: 0 4px; white-space: nowrap; }
  @media (max-width: 480px) {
    .lista-temas-prontos { grid-template-columns: 1fr; }
  }
  .lista-como-jogar { margin: 0; padding-left: 22px; display: flex; flex-direction: column; gap: 12px; }
  .lista-como-jogar li { font-size: 0.9rem; line-height: 1.55; color: #e2e8f0; }

  @media (max-width: 640px) {
    .setup-painel { padding: 24px; }
  }

  /* Centro do Tabuleiro - Glassmorphism Efetuado */
  #center-board {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    max-width: 1280px;
    background: var(--panel-bg);
    border: 1px solid var(--panel-border);
    border-radius: 24px;
    padding: 18px;
    backdrop-filter: blur(12px); /* Efeito de vidro fosco */
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.6), inset 0 0 20px rgba(255,255,255,0.05);
    box-sizing: border-box;
  }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 16px;
    border-bottom: 1px solid var(--panel-border);
    padding-bottom: 12px;
  }
  
  .topbar h1 {
    font-size: clamp(1.1rem, 3vw, 1.7rem);
    font-weight: 800;
    margin: 0;
    min-width: 0;
    overflow-wrap: break-word;
    background: linear-gradient(to right, #4ade80, #3b82f6, #c084fc);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    text-shadow: 0 4px 15px rgba(0,0,0,0.5);
  }
  
  .round-pill {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #f8fafc;
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.4), rgba(139, 92, 246, 0.4));
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    padding: 7px 14px;
    box-shadow: 0 0 15px rgba(59, 130, 246, 0.3);
    flex-shrink: 0;
    white-space: nowrap;
  }

  /* Campos de Batalha */
  .campos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  
  .campo {
    background: linear-gradient(180deg, rgba(30, 41, 59, 0.6), rgba(15, 23, 42, 0.8));
    border: 1px solid rgba(148, 163, 184, 0.3);
    border-radius: 16px;
    padding: 12px;
    min-height: 260px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    position: relative;
    overflow: hidden;
    transition: transform 0.2s, border-color 0.2s;
  }
  
  .campo:hover {
    border-color: rgba(96, 165, 250, 0.6);
    box-shadow: 0 0 20px rgba(96, 165, 250, 0.15);
  }

  .campo-titulo { display: flex; align-items: center; gap: 10px; z-index: 1; }
  .campo-nome { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 1.15rem; color: #fff;}
  .campo-desc { font-size: 0.75rem; color: var(--text-muted); line-height: 1.4; z-index: 1; min-height: 34px;}
  .campo-oculto .campo-nome, .campo-oculto .campo-desc { filter: blur(4px); opacity: 0.3; user-select: none;}
  
  .lane-score {
    display: flex; justify-content: space-between; font-size: 0.85rem; font-weight: 700;
    z-index: 1; padding: 6px 12px; background: rgba(0, 0, 0, 0.5); border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .lane-score b { color: #60a5fa; font-family: 'Space Grotesk', sans-serif; font-size: 1.15rem; }

  .lado-campo { z-index: 1; border-radius: 12px; padding: 8px; flex: 1; display: flex; flex-direction: column; }
  .lado-jogador { background: rgba(96, 165, 250, 0.1); border: 1px dashed rgba(96, 165, 250, 0.4); cursor: pointer; }
  .lado-jogador:hover { background: rgba(96, 165, 250, 0.15); }
  .lado-jogador.cheio { cursor: not-allowed; opacity: 0.5; }
  .lado-jogador.selecionavel { box-shadow: 0 0 20px rgba(96, 165, 250, 0.5) inset; border-style: solid; border-color: #60a5fa;}
  .lado-bot { background: rgba(239, 68, 68, 0.08); border: 1px dashed rgba(239, 68, 68, 0.3); }
  
  .lado-label {
    font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.1em;
    color: var(--text-muted); margin-bottom: 6px; display: flex; justify-content: space-between;
  }
  .lane-cartas { display: flex; flex-wrap: wrap; gap: 8px; min-height: 40px; }

  /* Mini Cartas no Tabuleiro */
  .mini-carta {
    background: rgba(30, 41, 59, 0.92); border-radius: 8px; padding: 7px 9px; width: 144px;
    border: 1px solid rgba(255, 255, 255, 0.2); box-shadow: 0 4px 8px rgba(0,0,0,0.4);
    cursor: pointer; display: flex; flex-direction: column; gap: 5px; position: relative; overflow: hidden;
    transition: transform 0.12s ease, border-color 0.12s ease;
  }
  .mini-carta:hover { transform: translateY(-2px); border-color: rgba(255,255,255,0.5); }
  .mini-carta::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; }
  .mini-carta.dono1::before { background: #ef4444; }
  .mini-carta.dono0::before { background: #3b82f6; }
  .mini-carta .topo-mini { display: flex; align-items: center; justify-content: space-between; gap: 6px; }
  .mini-carta .nome {
    font-weight: 700; font-size: 0.8rem; line-height: 1.2; color: #fff;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  
  .mini-carta .poder { font-family: 'Space Grotesk', sans-serif; font-weight: 800; font-size: 1.2rem; display: flex; align-items: center; gap: 4px; flex-shrink: 0; }
  .buffed { color: var(--buff-color); text-shadow: 0 0 10px rgba(16, 185, 129, 0.5); }
  .nerfed { color: var(--nerf-color); text-shadow: 0 0 10px rgba(239, 68, 68, 0.5); }
  .status-icon { font-size: 0.75rem; }
  .mini-carta .toque-dica { font-size: 0.55rem; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em; }
  .mini-carta.staged { outline: 2px dashed #60a5fa; outline-offset: 2px; opacity: 0.9; }


  /* Controles Status (Energia/Botões) */
  .status-linha {
    display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;
    background: rgba(0,0,0,0.4); padding: 12px 20px; border-radius: 16px; border: 1px solid var(--panel-border);
  }
  .btn-utilitario { padding: 10px 16px; font-size: 0.78rem; }
  
  .energia { display: flex; align-items: center; gap: 10px; font-size: 1rem; font-weight: 600;}
  .energia b { color: var(--energy-color); font-size: 1.2rem; font-family: 'Space Grotesk';}
  .fireflies { display: flex; gap: 6px; }
  .firefly { width: 12px; height: 12px; border-radius: 50%; background: rgba(14, 165, 233, 0.2); border: 1px solid rgba(14, 165, 233, 0.4);}
  .firefly.acesa { background: var(--energy-color); box-shadow: 0 0 12px 3px rgba(14, 165, 233, 0.7); }

  .btn {
    font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 0.95rem;
    border: 1px solid rgba(255,255,255,0.2); border-radius: 12px; padding: 12px 26px; cursor: pointer;
    background: linear-gradient(135deg, #2563eb, #7c3aed); color: white;
    transition: transform 0.15s ease, box-shadow 0.15s ease; text-transform: uppercase; letter-spacing: 0.05em;
  }
  .btn:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(59, 130, 246, 0.6); }
  .btn:active { transform: scale(0.95); }
  .btn:disabled { background: rgba(51, 65, 85, 0.8); box-shadow: none; color: #94a3b8; cursor: not-allowed; transform: none; border-color: transparent;}
  .btn.secundario { background: rgba(0,0,0,0.4); color: #e2e8f0; border: 1px solid var(--panel-border); box-shadow: none; }
  .btn.secundario:hover { background: rgba(255,255,255,0.1); }

  /* Pop-up de detalhes da carta no campo de batalha */
  .carta-popup-conteudo { text-align: left; max-width: 400px; position: relative; padding-top: 34px; max-height: 85vh; overflow-y: auto; }
  .popup-escolher-conteudo { max-width: 560px; max-height: 82vh; overflow-y: auto; }
  .btn-fechar-popup {
    position: absolute; top: 14px; right: 14px; width: 30px; height: 30px; border-radius: 50%;
    background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.2); color: #fff;
    font-size: 1rem; cursor: pointer; display: flex; align-items: center; justify-content: center;
  }
  .btn-fechar-popup:hover { background: rgba(255,255,255,0.18); }
  .popup-cabecalho { display: flex; align-items: center; gap: 14px; margin-bottom: 14px; }
  .popup-nome { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 1.3rem; color: #fff; }
  .popup-dono { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); }
  .popup-poder {
    font-family: 'Space Grotesk', sans-serif; font-weight: 800; font-size: 2rem; margin-bottom: 12px;
    display: flex; align-items: center; gap: 8px; color: #fff;
  }
  .popup-poder .poder-base { font-size: 1rem; font-weight: 500; color: var(--text-muted); }
  .popup-desc {
    font-size: 0.9rem; line-height: 1.5; color: #e2e8f0; background: rgba(0,0,0,0.35);
    border-radius: 10px; padding: 12px 14px; margin-bottom: 12px; border: 1px solid rgba(255,255,255,0.08);
  }
  .popup-tags { font-size: 0.7rem; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.06em; }
  .popup-custo { font-size: 0.8rem; color: var(--text-muted); margin-bottom: 6px; }

  /* Container da Mão 15 Cartas */
  #mao-container {
    height: 235px;
    width: 100%;
    background: rgba(15, 23, 42, 0.75); /* Translúcido para ver o fundo */
    backdrop-filter: blur(16px);
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    display: flex;
    align-items: center;
    padding: 0 20px;
    gap: 15px;
    overflow-x: auto;
    overflow-y: hidden;
    box-shadow: 0 -10px 40px rgba(0,0,0,0.5);
    z-index: 100;
  }
  
  /* Scrollbar customizada e responsiva */
  #mao-container::-webkit-scrollbar { height: 12px; }
  #mao-container::-webkit-scrollbar-track { background: rgba(0,0,0,0.3); border-radius: 10px; margin: 0 20px;}
  #mao-container::-webkit-scrollbar-thumb { background: rgba(96, 165, 250, 0.6); border-radius: 10px; border: 2px solid rgba(15, 23, 42, 1);}
  #mao-container::-webkit-scrollbar-thumb:hover { background: rgba(96, 165, 250, 0.9); }

  .carta {
    position: relative;
    flex-shrink: 0;
    width: 150px;
    height: 215px;
    background: linear-gradient(135deg, rgba(30, 41, 59, 0.9), rgba(15, 23, 42, 0.95));
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 14px;
    padding: 12px;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 8px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.6);
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
  }
  
  .carta:hover {
    transform: translateY(-12px);
    border-color: #60a5fa;
    box-shadow: 0 15px 35px rgba(96, 165, 250, 0.4);
  }
  
  .carta.selecionada {
    border-color: #f43f5e;
    box-shadow: 0 0 25px rgba(244, 63, 94, 0.6);
    transform: translateY(-18px);
  }
  
  .carta.inacessivel { filter: grayscale(80%) brightness(0.5); cursor: not-allowed; }
  
  .carta .topo { display: flex; justify-content: space-between; align-items: center; }
  .custo {
    background: var(--energy-color); color: #fff; font-weight: 800; font-size: 0.9rem; font-family: 'Space Grotesk';
    border-radius: 50%; width: 26px; height: 26px; display: flex; align-items: center; justify-content: center;
    box-shadow: 0 0 10px rgba(14, 165, 233, 0.6);
  }
  .poder-tag { font-family: 'Space Grotesk', sans-serif; font-weight: 800; font-size: 1.2rem; color: #fff; }
  .carta .nome { font-size: 0.85rem; font-weight: 700; line-height: 1.2; text-align: center; color: #fff;}
  .carta .desc {
    font-size: 0.65rem; line-height: 1.35; color: #cbd5e1;
    background: rgba(0,0,0,0.4); border-radius: 8px; padding: 8px; flex-grow: 1;
    border: 1px solid rgba(255,255,255,0.05);
  }
  .carta .tags { font-size: 0.55rem; color: #94a3b8; text-align: center; text-transform: uppercase; letter-spacing: 0.05em;}

  .overlay {
    position: fixed; inset: 0; background: rgba(0,0,0,0.85); backdrop-filter: blur(10px);
    display: flex; align-items: center; justify-content: center; z-index: 1000; padding: 20px;
  }
  .cartao-final {
    background: rgba(30, 41, 59, 0.95); color: #fff; border-radius: 24px; padding: 40px;
    width: 100%; max-width: 450px; text-align: center;
    border: 1px solid rgba(255,255,255,0.2); box-shadow: 0 25px 50px rgba(0,0,0,0.6);
  }
  .cartao-final h2 { font-size: 2.5rem; margin: 0 0 15px; color: #60a5fa; }
  .linha-resultado { display: flex; justify-content: space-between; font-size: 1rem; padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,0.1); }
  .oculto { display: none !important; }

  /* Ilustrações SVGs */
  .icone-badge {
    flex-shrink: 0; border-radius: 10px; display: flex; align-items: center; justify-content: center;
    background: linear-gradient(135deg, rgba(255,255,255,0.15), transparent);
    border: 1px solid rgba(255,255,255,0.25); background-color: var(--cor);
  }
  .icone-badge svg { fill: none; stroke: #fff; stroke-width: 5; stroke-linecap: square; stroke-linejoin: bevel; }

  .carta-arte {
    height: 60px; border-radius: 8px; display: flex; align-items: center; justify-content: center;
    background: linear-gradient(135deg, rgba(255,255,255,0.2), transparent);
    background-color: var(--cor); border: 1px solid rgba(255,255,255,0.15); margin-bottom: 4px;
  }
  .carta-arte svg { width: 36px; height: 36px; fill: none; stroke: #fff; stroke-width: 4; stroke-linecap: square; stroke-linejoin: bevel; }

  .campo-titulo .icone-badge { width: 32px; height: 32px; border-radius: 8px;}
  .campo-titulo .icone-badge svg { width: 18px; height: 18px; stroke-width: 6; }
</style>
</head>
<body>

